[Unit]
Description=Sync Podman Quadlet units from git (robbe)
Documentation=https://github.com/m4schini/robbe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={{.Binary}} sync
ConfigurationDirectory=robbe
CacheDirectory=robbe
StateDirectory=robbe
RuntimeDirectory=robbe
# Keep the lock file's directory across stops so a manual run and the timer
# always contend for the same inode (see app/sync lock()).
RuntimeDirectoryPreserve=yes
